pkgname=path-of-upgrading
pkgver=0.5.0
pkgrel=1
pkgdesc='Path of Exile 2 item overlay that checks items against your build'
arch=(x86_64)
url='https://github.com/coreydeli/path-of-upgrading'
license=(MIT OFL-1.1)
depends=(
  gcc-libs glibc
  qt6-base qt6-declarative qt6-wayland
  kirigami kirigami-addons kdeclarative ki18n kdbusaddons kcolorscheme kglobalaccel
  knotifications kstatusnotifieritem kwindowsystem
  layer-shell-qt qtkeychain-qt6 libxcb xcb-util-keysyms zlib
  hicolor-icon-theme
)
makedepends=(cmake ninja kconfig)
checkdepends=(xorg-server-xvfb xorg-xauth dbus)
optdepends=(
  'qqc2-desktop-style: the Plasma style for the window'
  'flatpak: Path of Building from Flathub'
  'luajit: to run another install of Path of Building'
)
# Linking every test with LTO took longer than building the rest
options=(!lto)
# The release builds put the tarball from git archive here, under this name.
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

# A beta is cut from the version it leads up to, so the release builds unpack it
# there. The paths stay the same from one beta to the next, and ccache hits.
_srcdir=$pkgname-${pkgver%%beta*}

build() {
  # trade searches start on in a beta, and off in a release
  local beta=OFF
  if [[ $pkgver == *beta* ]]; then
    beta=ON
  fi
  cmake -B build -S "$_srcdir" -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DPOU_BETA=$beta
  cmake --build build
}

check() {
  cd build
  sh "../$_srcdir/.github/scripts/run-tests.sh"
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$_srcdir/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname"
}
